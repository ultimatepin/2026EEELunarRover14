    Serial.print(F("  conf="));
    Serial.print(currentRock.fusionConfidence, 2);
  } else {
    Serial.print(F("UNKNOWN"));
  }
  Serial.println();
  
  Serial.println(F("================================================"));
}

// ========================== HTTP ENDPOINTS ==========================

// --- Motor command endpoint: /motor?cmd=w|s|a|d|wa|wd|sa|sd|q|e|stop&speed=N ---
void handleMotor() {
  server.sendHeader("Access-Control-Allow-Origin", "*");

  // Optional speed parameter
  if (server.hasArg("speed")) {
    int s = server.arg("speed").toInt();
    if (s >= 0 && s <= 255) motorSpeed = s;
  }

  String cmd = server.hasArg("cmd") ? server.arg("cmd") : "";
  cmd.trim();
  cmd.toLowerCase();

  bool known = true;

  if (cmd == "" || cmd == "stop") {
    motorStop();
    cmd = "stop";
  }
  else if (cmd == "w") {
    motorForward();
  }
  else if (cmd == "s") {
    motorReverse();
  }
  else if (cmd == "a") {
    motorLeft();
  }
  else if (cmd == "d") {
    motorRight();
  }
  else if (cmd == "wa" || cmd == "aw") {
    motorFwdLeft();
  }
  else if (cmd == "wd" || cmd == "dw") {
    motorFwdRight();
  }
  else if (cmd == "sa" || cmd == "as") {
    motorRevLeft();
  }
  else if (cmd == "sd" || cmd == "ds") {
    motorRevRight();
  }
  else if (cmd == "q") {
    motorRotCCW();   // rotate left
  }
  else if (cmd == "e") {
    motorRotCW();    // rotate right
  }
  else {
    motorStop();     // unknown sequence = safe stop
    known = false;
    cmd = "stop";
  }

  Serial.print(F("[MOTOR] "));
  Serial.print(cmd);
  Serial.print(F(" spd="));
  Serial.print(motorSpeed);

  if (!known) {
    Serial.print(F(" (unknown command received, stopped)"));
  }

  Serial.println();

  server.send(200, F("text/plain"), cmd);
}

void handleRoot() {
  server.send(200, "text/plain", "Rover OK. Use dashboard HTML on laptop.");
}

// JSON endpoint: returns current classification state
void handleSensor() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  String json = "{";
  
  // Age
  json += "\"age\":";
  if (currentRock.ageValid) {
    json += "\"" + String(currentRock.age) + "\"";
  } else {
    json += "null";
  }
  
  // IR
  json += ",\"ir\":{\"class\":";
  json += currentRock.ir.valid ? String(currentRock.ir.classIndex) : "null";
  json += ",\"conf\":";
  json += currentRock.ir.valid ? String(currentRock.ir.confidence, 2) : "null";
  json += ",\"label\":";
  json += currentRock.ir.valid ? 
    (currentRock.ir.classIndex ? "\"HIGH\"" : "\"LOW\"") : "null";
  json += "}";
  
  // Ultrasonic
  json += ",\"ultrasonic\":{\"class\":";
  json += currentRock.ultrasonic.valid ? String(currentRock.ultrasonic.classIndex) : "null";
  json += ",\"conf\":";
  json += currentRock.ultrasonic.valid ? String(currentRock.ultrasonic.confidence, 2) : "null";
  json += ",\"label\":";
  json += currentRock.ultrasonic.valid ? 
    (currentRock.ultrasonic.classIndex ? "\"PRESENT\"" : "\"ABSENT\"") : "null";
  json += "}";
  
  // Magnetic
  json += ",\"magnetic\":{\"class\":";
  json += currentRock.magnetic.valid ? String(currentRock.magnetic.classIndex) : "null";
  json += ",\"conf\":";
  json += currentRock.magnetic.valid ? String(currentRock.magnetic.confidence, 2) : "null";
  json += ",\"label\":";
  json += currentRock.magnetic.valid ? 
    (currentRock.magnetic.classIndex ? "\"DOWN\"" : "\"UP\"") : "null";
  json += "}";
  
  // Fusion
  json += ",\"rockType\":";
  json += currentRock.fusionValid ? 
    ("\"" + String(currentRock.rockType) + "\"") : "null";
  json += ",\"fusionConf\":";
  json += currentRock.fusionValid ? String(currentRock.fusionConfidence, 2) : "null";
  
  json += "}";
  
  server.send(200, F("application/json"), json);
}

void handleNotFound() {
  String message = F("File Not Found\n\nURI: ");
  message += server.uri();
  server.send(404, F("text/plain"), message);
}

// ========================== SETUP ==========================

void setup() {
  pinMode(LED_BUILTIN, OUTPUT);
  digitalWrite(LED_BUILTIN, 0);
  
  // Debug serial (USB)
  Serial.begin(9600);
  while (!Serial && millis() < 10000);  // Wait for serial monitor (remove for standalone)
  
  Serial.println(F("\n===================================="));
  Serial.println(F("  EEELunarRover Classification System"));
#if SIMULATED_MODE
  Serial.println(F("  *** SIMULATED MODE ***"));
#else
  Serial.println(F("  *** HARDWARE MODE ***"));
#endif
  Serial.println(F("====================================\n"));
  
#if !SIMULATED_MODE
  // Real hardware setup
  Serial1.begin(600);  // UART from radio receiver on Pin 0
  pinMode(PIN_IR_INTERRUPT, INPUT);
  attachInterrupt(digitalPinToInterrupt(PIN_IR_INTERRUPT), irPulseISR, RISING);
  // Initialise BMM150 magnetometer (with graceful degradation)
  Wire.begin();
  const int BMM150_MAX_RETRIES = 3;
  for (int attempt = 1; attempt <= BMM150_MAX_RETRIES; attempt++) {
    if (bmm150.begin() == BMM150_OK) {
      bmm150.setOperationMode(BMM150_POWERMODE_NORMAL);
      bmm150.setPresetMode(BMM150_PRESETMODE_HIGHACCURACY);
      bmm150.setRate(BMM150_DATA_RATE_30HZ);
      bmm150Ready = true;
      Serial.println(F("[MAG] BMM150 initialised OK"));
      break;
    }
    Serial.print(F("[MAG] BMM150 init attempt "));
    Serial.print(attempt);
    Serial.print(F("/"));
    Serial.print(BMM150_MAX_RETRIES);
    Serial.println(F(" failed — check I2C wiring (SDA/SCL) and CS→GND"));
    delay(500);
  }
  if (!bmm150Ready) {
    Serial.println(F("[MAG] BMM150 unavailable — system continues with IR + US only"));
  }
#endif
  
  // Initialise rock data
  memset(&currentRock, 0, sizeof(currentRock));
  currentRock.ageValid = false;
  currentRock.fusionValid = false;
  
  // Initialise motors
  motorsInit();
  Serial.println(F("[MOTOR] 4x mecanum motors initialised (pins are placeholders)"));
  
  // Seed simulation RNG
  simSeed = micros();
  
  // WiFi setup (same as starter code)
  Serial.println(F("Starting Web Server..."));
  
  if (WiFi.status() == WL_NO_SHIELD) {
    Serial.println(F("WiFi shield not present"));
    // In simulated mode, continue without WiFi for serial-only testing
#if !SIMULATED_MODE
    while (true);
#else
    Serial.println(F("Continuing without WiFi (simulated mode)"));
#endif
  } else {
    if (groupNumber)
      WiFi.config(IPAddress(192, 168, 0, groupNumber + 1));
    
    Serial.print(F("Connecting to WPA SSID: "));
    Serial.println(ssid);
    while (WiFi.begin(ssid, pass) != WL_CONNECTED) {
      delay(500);
      Serial.print('.');
    }
    
    server.on(F("/"), handleRoot);
    server.on(F("/sensor"), handleSensor);
    server.on(F("/motor"), handleMotor);
    server.onNotFound(handleNotFound);
    server.begin();
    
    Serial.print(F("HTTP server started @ "));
    Serial.println(static_cast<IPAddress>(WiFi.localIP()));
  }
  
  Serial.println(F("\nSystem ready. Waiting for sensor data...\n"));
}

// ========================== MAIN LOOP (NON-BLOCKING) ==========================

void loop() {
  unsigned long now = millis();
  
  // 1. Handle WiFi clients
  server.handleClient();
  
  // 2. Poll UART for age data
  pollUart();
  
  // 3. Simulated UART injection (periodic)
#if SIMULATED_MODE
  if (now - lastSimUart >= SIM_UART_INTERVAL_MS) {
    lastSimUart = now;
    simulateUartReceive();
  }
#endif
  
  // 4. Run classification pipeline (periodic)
  if (now - lastSensorPoll >= SENSOR_POLL_INTERVAL_MS) {
    lastSensorPoll = now;
    fuseAndClassify();
  }
  
  // 5. Print full status (periodic)
  if (now - lastSerialPrint >= SERIAL_PRINT_INTERVAL_MS) {
    lastSerialPrint = now;
    printFullStatus();
  }
}
