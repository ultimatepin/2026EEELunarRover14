}

// Simulate BMM150 Z-axis reading in µT
// Positive Z → UP, Negative Z → DOWN (matches typical sensor orientation)
float simulateBmm150Z() {
  if (simRandom(2) == 0) {
    return -(200.0 + simRandom(150));  // Down: -200 to -350 µT
  } else {
    return  (200.0 + simRandom(150));  // Up:   +200 to +350 µT
  }
}

