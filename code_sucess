// Simulate receiving a UART age string on Serial1
// In real mode, Serial1.read() provides this
void simulateUartReceive() {
  // Generate a random age like "#247"
  char simAge[5];
  simAge[0] = '#';
  simAge[1] = '1' + (simRandom(4));       // 1-4
  simAge[2] = '0' + (simRandom(10));      // 0-9
  simAge[3] = '0' + (simRandom(10));      // 0-9
  simAge[4] = '\0';
  
  // Feed into the UART parser
  for (int i = 0; i < 4; i++) {
    processUartByte(simAge[i]);
  }
}

// Simulate IR pulse count over a window
// Returns a Poisson-distributed count for the given window
unsigned long simulateIrPulseCount(unsigned long windowMs) {
  // Simulate Basaltoid (high λ = 547 s^-1) with some noise
  float trueLambda = (simRandom(2) == 0) ? LAMBDA_HIGH : LAMBDA_LOW;
  float expectedCount = trueLambda * (windowMs / 1000.0);
  
  // Approximate Poisson with Gaussian for large λ: N(λt, λt)
  // Simple Box-Muller-ish approximation using uniform randoms
  float u1 = (simRandom(10000) + 1) / 10000.0;
  float u2 = (simRandom(10000) + 1) / 10000.0;
  // Rough normal approximation: sum of uniforms, centered
  float noise = (u1 + u2 - 1.0) * sqrt(expectedCount);
  
  long count = (long)(expectedCount + noise);
  if (count < 0) count = 0;
  return (unsigned long)count;
}

// Simulate ultrasonic detection (binary)
bool simulateUltrasonicPresent() {
