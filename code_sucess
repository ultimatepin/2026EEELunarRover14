// ========================== UART AGE DECODING ==========================
// Parses incoming bytes looking for '#' followed by 3 digit characters

void processUartByte(char c) {
  if (c == '#') {
    // Start of a new age string
    uartBuffer[0] = '#';
    uartBufferIdx = 1;
    uartReceiving = true;
  } else if (uartReceiving) {
    uartBuffer[uartBufferIdx] = c;
    uartBufferIdx++;
    
    if (uartBufferIdx >= 4) {
      // Complete: 4 chars received (#xxx)
      uartBuffer[4] = '\0';
      
      // Validate: chars 1-3 should be digits
      bool valid = true;
      for (int i = 1; i < 4; i++) {
        if (uartBuffer[i] < '0' || uartBuffer[i] > '9') {
          valid = false;
          break;
        }
      }
      
      if (valid) {
        strncpy(currentRock.age, uartBuffer, sizeof(currentRock.age));
        currentRock.ageValid = true;
        Serial.print(F("[UART] Age received: "));
        Serial.println(currentRock.age);
      } else {
        Serial.println(F("[UART] Invalid age string, discarded"));
      }
      
      uartReceiving = false;
      uartBufferIdx = 0;
    }
  }
  // If not '#' and not currently receiving, ignore (noise)
}

void pollUart() {
#if SIMULATED_MODE
#else
while (Serial1.available()) {
    char c = Serial1.read();
    processUartByte(c);
}
#endif
}

// ========================== IR PULSE RATE ESTIMATION ==========================
// Uses Poisson log-likelihood ratio test (LRT):
//   H0: λ = λ_low  (312 s^-1)
//   H1: λ = λ_high (547 s^-1)
//   
//   Log-likelihood ratio: Λ = k * ln(λ1/λ0) - (λ1 - λ0) * T
//   where k = pulse count, T = window duration in seconds
//   
//   Decision: Λ > 0 → H1 (high rate), Λ < 0 → H0 (low rate)
//   Confidence: derived from |Λ| (larger magnitude = more certain)

// ISR for real hardware mode
void irPulseISR() {
  irPulseCount++;
}

SensorResult classifyIrRate() {
  SensorResult result;
  unsigned long count;
  float windowSec;

#if SIMULATED_MODE
  windowSec = IR_WINDOW_MS / 1000.0;
  count = simulateIrPulseCount(IR_WINDOW_MS);
#else
  unsigned long now = millis();

  if (!irWindowActive) {
    // First call after boot: start the counting window, cannot classify yet.
    // The ISR will accumulate pulses between now and the next call.
    noInterrupts();
    irPulseCount = 0;
    interrupts();
    irWindowStart = now;
    irWindowActive = true;

    result.valid = false;
    result.classIndex = -1;
    result.confidence = 0.0;
    Serial.println(F("[IR] Counting window started, waiting for first interval..."));
    return result;
  }

  // Subsequent calls: harvest the accumulated count, then restart the window.
  noInterrupts();
  count = irPulseCount;
  irPulseCount = 0;          // Reset for the next window
  interrupts();

  unsigned long elapsedMs = now - irWindowStart;
  irWindowStart = now;       // Restart window immediately (no gap)

  if (elapsedMs < 50) {
    // Window too short — statistically meaningless, skip
    result.valid = false;
    result.classIndex = -1;
    result.confidence = 0.0;
    Serial.println(F("[IR] Window too short (<50ms), skipping"));
    return result;
  }

  windowSec = elapsedMs / 1000.0;
#endif

  // ---- Common path: LRT classification (both simulated and hardware) ----

  // Observed rate (for debug display only; LRT uses count directly)
  float observedLambda = count / windowSec;

  // Poisson log-likelihood ratio test
  //   Λ = k · ln(λ₁/λ₀) − (λ₁ − λ₀) · T
  float logRatio = count * log(LAMBDA_HIGH / LAMBDA_LOW)
                   - (LAMBDA_HIGH - LAMBDA_LOW) * windowSec;

  // Decision: Λ > 0 → H₁ (high rate), Λ < 0 → H₀ (low rate)
  if (logRatio > 0) {
    result.classIndex = 1;  // High λ (547)
  } else {
    result.classIndex = 0;  // Low λ (312)
  }

  // Confidence: sigmoid-like saturating map of |Λ|
  float absLR = fabs(logRatio);
  result.confidence = absLR / (absLR + 5.0);  // → 1.0 as |Λ| → ∞

  result.valid = true;

  Serial.print(F("[IR] Count="));
  Serial.print(count);
  Serial.print(F(" T="));
  Serial.print(windowSec, 3);
  Serial.print(F("s λ_obs="));
  Serial.print(observedLambda, 1);
  Serial.print(F(" LLR="));
  Serial.print(logRatio, 2);
  Serial.print(F(" → "));
  Serial.print(result.classIndex ? "HIGH" : "LOW");
  Serial.print(F(" (conf="));
  Serial.print(result.confidence, 2);
  Serial.println(F(")"));

  return result;
}

