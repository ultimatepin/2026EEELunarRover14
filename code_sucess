// ========================== MAGNETIC POLARITY ==========================
// BMM150 3-axis magnetometer via I2C.
// We use the Z-axis to determine polarity: +Z = UP, -Z = DOWN.
// Readings below BMM150_DEADZONE_UT in magnitude are treated as "no magnet nearby".
//
// IMPORTANT: verify polarity convention with the orange disc magnet before the demo.
// If UP/DOWN is inverted, negate the Z reading (or flip the sensor mounting).

SensorResult classifyMagnetic() {
  SensorResult result;
  float z;

#if SIMULATED_MODE
  z = simulateBmm150Z();
#else
  if (!bmm150Ready) {
    // Sensor never initialised — return invalid so fusion falls back to IR + US
    result.valid      = false;
    result.classIndex = -1;
    result.confidence = 0.0;
    Serial.println(F("[MAG] BMM150 not available — skipping"));
    return result;
  }
  bmm150.setOperationMode(BMM150_POWERMODE_NORMAL); 
  sBmm150MagData_t magData = bmm150.getGeomagneticData();
  z = magData.z;  // µT, positive = field along +Z axis
#endif

  float absZ = fabs(z);

  if (absZ < BMM150_DEADZONE_UT) {
    // Too weak — sensor is probably too far from the magnet or no magnet present
    result.valid     = false;
    result.classIndex = -1;
    result.confidence = 0.0;
    Serial.print(F("[MAG] Z="));
    Serial.print(z, 1);
    Serial.println(F(" µT → UNCERTAIN (below deadzone)"));
  } else {
    result.valid      = true;
    // Negative Z = field pointing DOWN into rock surface → classIndex 1
    // Positive Z = field pointing UP out of rock surface → classIndex 0
    result.classIndex = (z < 0) ? 1 : 0;

    // Confidence: scales with |Z| up to BMM150_MAX_UT
    result.confidence = min(1.0f, absZ / BMM150_MAX_UT);

    Serial.print(F("[MAG] Z="));
    Serial.print(z, 1);
    Serial.print(F(" µT → "));
    Serial.print(result.classIndex ? "DOWN" : "UP");
    Serial.print(F(" (conf="));
    Serial.print(result.confidence, 2);
    Serial.println(F(")"));
  }

  return result;
}

// ========================== MULTI-SENSOR FUSION ==========================
// Rock type lookup table:
//   IR(high) + US(present) + Mag(down) = Basaltoid
//   IR(low)  + US(absent)  + Mag(down) = Gravion
//   IR(low)  + US(present) + Mag(up)   = Regolix
//   IR(high) + US(absent)  + Mag(up)   = Lunarite
//
// Encoding: IR=bit2, US=bit1, Mag=bit0
//   Basaltoid = 1,1,1 = 7
//   Gravion   = 0,0,1 = 1
//   Regolix   = 0,1,0 = 2
//   Lunarite  = 1,0,0 = 4
//
// Any 2 of 3 sensors uniquely identify the type.
// Strategy: if all 3 valid, use all 3 (and check consistency).
//           if only 2 valid, those 2 are sufficient.
//           if <2 valid, cannot classify.

// Lookup: given (ir, us, mag) indices, what rock type?
const char* lookupRockType(int ir, int us, int mag) {
  int code = (ir << 2) | (us << 1) | mag;
  switch (code) {
    case 7: return "Basaltoid";  // 111
    case 1: return "Gravion";    // 001
    case 2: return "Regolix";    // 010
    case 4: return "Lunarite";   // 100
    default: return "CONFLICT";  // Invalid combination
  }
}

void fuseAndClassify() {
  currentRock.ir         = classifyIrRate();
  currentRock.ultrasonic = classifyUltrasonic();
  currentRock.magnetic   = classifyMagnetic();
  
  int validCount = (currentRock.ir.valid ? 1 : 0)
                 + (currentRock.ultrasonic.valid ? 1 : 0)
                 + (currentRock.magnetic.valid ? 1 : 0);
  
  if (validCount < 2) {
    // Cannot classify with fewer than 2 sensors
    strncpy(currentRock.rockType, "UNKNOWN", sizeof(currentRock.rockType));
    currentRock.fusionConfidence = 0.0;
    currentRock.fusionValid = false;
    Serial.println(F("[FUSION] Insufficient valid sensors (<2), cannot classify"));
    return;
  }
  
  // Try all-three classification
  if (validCount == 3) {
    const char* fullResult = lookupRockType(
      currentRock.ir.classIndex,
      currentRock.ultrasonic.classIndex,
      currentRock.magnetic.classIndex
    );
    
    if (strcmp(fullResult, "CONFLICT") != 0) {
      // All three agree on a valid type
      strncpy(currentRock.rockType, fullResult, sizeof(currentRock.rockType));
      currentRock.fusionConfidence = 
        (currentRock.ir.confidence + currentRock.ultrasonic.confidence 
         + currentRock.magnetic.confidence) / 3.0;
      currentRock.fusionValid = true;
      Serial.print(F("[FUSION] All 3 sensors → "));
      Serial.println(currentRock.rockType);
      return;
    }
    
    // Conflict: fall through to 2-sensor pairs, pick highest-confidence pair
    Serial.println(F("[FUSION] 3-sensor conflict, trying 2-sensor pairs"));
  }
  
  // Try each pair of 2 sensors, pick the pair with highest combined confidence
  struct Pair {
    int ir, us, mag;          // -1 if that sensor is excluded
    float totalConf;
    const char* result;
  };
  
  Pair bestPair;
  bestPair.totalConf = -1.0;
  bestPair.result = "UNKNOWN";
  
  // Pair 1: IR + US (infer mag from table)
  if (currentRock.ir.valid && currentRock.ultrasonic.valid) {
    // For each valid (ir, us) combo, there's exactly one rock type
    // IR=1,US=1 → Basaltoid(mag=1), IR=0,US=0 → Gravion(mag=1)
    // IR=0,US=1 → Regolix(mag=0),   IR=1,US=0 → Lunarite(mag=0)
    int inferredMag;
    if (currentRock.ir.classIndex == 1 && currentRock.ultrasonic.classIndex == 1) inferredMag = 1;
    else if (currentRock.ir.classIndex == 0 && currentRock.ultrasonic.classIndex == 0) inferredMag = 1;
    else if (currentRock.ir.classIndex == 0 && currentRock.ultrasonic.classIndex == 1) inferredMag = 0;
    else inferredMag = 0;  // ir=1, us=0 → Lunarite → mag=0 (up)
    
    float conf = (currentRock.ir.confidence + currentRock.ultrasonic.confidence) / 2.0;
    const char* res = lookupRockType(currentRock.ir.classIndex, 
                                      currentRock.ultrasonic.classIndex, inferredMag);
    if (conf > bestPair.totalConf && strcmp(res, "CONFLICT") != 0) {
      bestPair.totalConf = conf;
      bestPair.result = res;
    }
  }
  
  // Pair 2: IR + Mag (infer us from table)
  if (currentRock.ir.valid && currentRock.magnetic.valid) {
    int inferredUs;
    if (currentRock.ir.classIndex == 1 && currentRock.magnetic.classIndex == 1) inferredUs = 1;      // Basaltoid
    else if (currentRock.ir.classIndex == 0 && currentRock.magnetic.classIndex == 1) inferredUs = 0;  // Gravion
    else if (currentRock.ir.classIndex == 0 && currentRock.magnetic.classIndex == 0) inferredUs = 1;  // Regolix
    else inferredUs = 0;  // ir=1, mag=0 → Lunarite
    
    float conf = (currentRock.ir.confidence + currentRock.magnetic.confidence) / 2.0;
    const char* res = lookupRockType(currentRock.ir.classIndex, inferredUs,
                                      currentRock.magnetic.classIndex);
    if (conf > bestPair.totalConf && strcmp(res, "CONFLICT") != 0) {
      bestPair.totalConf = conf;
      bestPair.result = res;
    }
  }
  
  // Pair 3: US + Mag (infer ir from table)
  if (currentRock.ultrasonic.valid && currentRock.magnetic.valid) {
    int inferredIr;
    if (currentRock.ultrasonic.classIndex == 1 && currentRock.magnetic.classIndex == 1) inferredIr = 1;  // Basaltoid
    else if (currentRock.ultrasonic.classIndex == 0 && currentRock.magnetic.classIndex == 1) inferredIr = 0;  // Gravion
    else if (currentRock.ultrasonic.classIndex == 1 && currentRock.magnetic.classIndex == 0) inferredIr = 0;  // Regolix
    else inferredIr = 1;  // us=0, mag=0 → Lunarite
    
    float conf = (currentRock.ultrasonic.confidence + currentRock.magnetic.confidence) / 2.0;
    const char* res = lookupRockType(inferredIr, currentRock.ultrasonic.classIndex,
                                      currentRock.magnetic.classIndex);
    if (conf > bestPair.totalConf && strcmp(res, "CONFLICT") != 0) {
      bestPair.totalConf = conf;
      bestPair.result = res;
    }
  }
  
  strncpy(currentRock.rockType, bestPair.result, sizeof(currentRock.rockType));
  currentRock.fusionConfidence = bestPair.totalConf;
  currentRock.fusionValid = (bestPair.totalConf > 0);
  
  Serial.print(F("[FUSION] Best 2-sensor pair → "));
  Serial.print(currentRock.rockType);
  Serial.print(F(" (conf="));
  Serial.print(currentRock.fusionConfidence, 2);
  Serial.println(F(")"));
}

// ========================== MECANUM MOTOR CONTROL ==========================
// 4-wheel mecanum kinematics:
//   Each wheel's roller axis is at 45° to the wheel axis.
//   By combining forward/reverse on each wheel, we get holonomic motion.
//
//   Wheel speed signs for each motion command:
//     Command     FL   FR   RL   RR
//     forward     +    +    +    +
//     reverse     -    -    -    -
//     left        -    +    +    -
//     right       +    -    -    +
//     fwd-left    0    +    +    0
//     fwd-right   +    0    0    +
//     rev-left    -    0    0    -
//     rev-right   0    -    -    0
//     rot-cw      +    -    +    -
//     rot-ccw     -    +    -    +
//     stop        0    0    0    0

int motorSpeed = 180;  // Default PWM (0-255), adjustable via /motor?speed=N

void motorsInit() {
  pinMode(PIN_FL_DIR, OUTPUT);  pinMode(PIN_FL_PWM, OUTPUT);
  pinMode(PIN_FR_DIR, OUTPUT);  pinMode(PIN_FR_PWM, OUTPUT);
  pinMode(PIN_RL_DIR, OUTPUT);  pinMode(PIN_RL_PWM, OUTPUT);
  pinMode(PIN_RR_DIR, OUTPUT);  pinMode(PIN_RR_PWM, OUTPUT);
  // Start stopped
  analogWrite(PIN_FL_PWM, 0);  analogWrite(PIN_FR_PWM, 0);
  analogWrite(PIN_RL_PWM, 0);  analogWrite(PIN_RR_PWM, 0);
}

// Set a single motor: dir = HIGH for forward, LOW for reverse; spd = 0-255
void setMotor(int dirPin, int pwmPin, bool forward, int spd) {
  digitalWrite(dirPin, forward ? LOW : HIGH);
  analogWrite(pwmPin, spd);
}

// Set all 4 motors at once. Sign convention: +1 = forward, -1 = reverse, 0 = stop
void setAllMotors(int fl, int fr, int rl, int rr, int spd) {
  setMotor(PIN_FL_DIR, PIN_FL_PWM, fl >= 0, fl == 0 ? 0 : spd);
  setMotor(PIN_FR_DIR, PIN_FR_PWM, fr >= 0, fr == 0 ? 0 : spd);
  setMotor(PIN_RL_DIR, PIN_RL_PWM, rl >= 0, rl == 0 ? 0 : spd);
  setMotor(PIN_RR_DIR, PIN_RR_PWM, rr >= 0, rr == 0 ? 0 : spd);
}

// Named motion commands using the mecanum kinematic table
void motorForward()  { setAllMotors(+1, +1, +1, +1, motorSpeed); }
void motorReverse()  { setAllMotors(-1, -1, -1, -1, motorSpeed); }
void motorLeft()     { setAllMotors(-1, +1, +1, -1, motorSpeed); }
void motorRight()    { setAllMotors(+1, -1, -1, +1, motorSpeed); }
void motorFwdLeft()  { setAllMotors( 0, +1, +1,  0, motorSpeed); }
void motorFwdRight() { setAllMotors(+1,  0,  0, +1, motorSpeed); }
void motorRevLeft()  { setAllMotors(-1,  0,  0, -1, motorSpeed); }
void motorRevRight() { setAllMotors( 0, -1, -1,  0, motorSpeed); }
void motorRotCW()    { setAllMotors(+1, -1, +1, -1, motorSpeed); }
void motorRotCCW()   { setAllMotors(-1, +1, -1, +1, motorSpeed); }
void motorStop()     { setAllMotors( 0,  0,  0,  0, 0); }

// ========================== STATUS PRINTING ==========================

void printFullStatus() {
  Serial.println(F("========== ROCK CLASSIFICATION STATUS =========="));
  
  Serial.print(F("  Age:  "));
  if (currentRock.ageValid) {
    Serial.print(currentRock.age);
    // Convert #xyz to x.yz billion years
    if (currentRock.age[0] == '#') {
      Serial.print(F(" → "));
      Serial.print(currentRock.age[1]);
      Serial.print('.');
      Serial.print(currentRock.age[2]);
      Serial.print(currentRock.age[3]);
      Serial.print(F(" billion years"));
    }
  } else {
    Serial.print(F("not received"));
  }
  Serial.println();
  
  Serial.print(F("  IR:   "));
  if (currentRock.ir.valid) {
    Serial.print(currentRock.ir.classIndex ? "HIGH (547)" : "LOW (312)");
    Serial.print(F("  conf="));
    Serial.print(currentRock.ir.confidence, 2);
  } else {
    Serial.print(F("invalid"));
  }
  Serial.println();
  
  Serial.print(F("  US:   "));
  if (currentRock.ultrasonic.valid) {
    Serial.print(currentRock.ultrasonic.classIndex ? "PRESENT" : "ABSENT");
    Serial.print(F("  conf="));
    Serial.print(currentRock.ultrasonic.confidence, 2);
  } else {
    Serial.print(F("invalid"));
  }
  Serial.println();
  
  Serial.print(F("  Mag:  "));
  if (currentRock.magnetic.valid) {
    Serial.print(currentRock.magnetic.classIndex ? "DOWN" : "UP");
    Serial.print(F("  conf="));
    Serial.print(currentRock.magnetic.confidence, 2);
  } else {
    Serial.print(F("invalid"));
  }
  Serial.println();
  
  Serial.print(F("  Type: "));
  if (currentRock.fusionValid) {
